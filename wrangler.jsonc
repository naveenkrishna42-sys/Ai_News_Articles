{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ainewsss",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "tivra-search"
    }
  ],
  "observability": {
    "enabled": true
  }
}
